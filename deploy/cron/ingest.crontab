# Auto-Ingest Cron Configuration
# Recurring production work enters fenced persisted controllers. Window-scoped
# job keys make duplicate triggers idempotent while allowing later windows.

# Sync legacy drop every 5 minutes.
*/5 * * * * cd /app && /usr/bin/env python3 -m auto_ingest.orchestration run --profile sync >> /var/log/cron-sync.log 2>&1

# Main ingest pipeline every 30 minutes, persisted at individual heavy stages.
*/30 * * * * cd /app && /usr/bin/env python3 -m auto_ingest.full_pipeline >> /var/log/cron-ingest.log 2>&1

# Daily dashcam embeddings batch at 2 AM.
0 2 * * * cd /app && /usr/bin/env python3 -m auto_ingest.orchestration run --profile dashcam >> /var/log/cron-dashcam-daily.log 2>&1
