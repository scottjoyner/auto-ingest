# Auto-Ingest Cron Configuration
# All recurring production work enters through the canonical fenced pipeline
# orchestrator. Window-scoped job keys make duplicate cron/service triggers
# idempotent while allowing the next schedule window to run normally.

# Sync legacy drop every 5 minutes.
*/5 * * * * cd /app && /usr/bin/env python3 -m auto_ingest.orchestration run --profile sync >> /var/log/cron-sync.log 2>&1

# Main ingest pipeline every 30 minutes.
*/30 * * * * cd /app && /usr/bin/env python3 -m auto_ingest.orchestration run --profile full >> /var/log/cron-ingest.log 2>&1

# Daily dashcam embeddings batch at 2 AM.
0 2 * * * cd /app && /usr/bin/env python3 -m auto_ingest.orchestration run --profile dashcam >> /var/log/cron-dashcam-daily.log 2>&1
