# x1-370 observed storage namespace, October 16 2026.
# EXAMPLE ONLY: never automatically deploy or treat paths as verified identities.
# The x1 path /nas/X resolves to physical Beelink /nas/fileserver/X.
# Beelink's OWN /nas/X is not necessarily the same directory/subvolume.
NAS_ROOT=/nas
CANONICAL_ROOT=/nas
DROP_ROOT=/nas/drop
LEGACY_ROOT=/nas
AUDIO_ROOT=/nas/audio
BODYCAM_ROOT=/nas/bodycam
# Proposed canonical archive destination; verify storage ownership first.
DASHCAM_ROOT=/nas/archive/dashcam
CUSTODY_DESTINATION_ROOT=/nas/archive/dashcam
CUSTODY_LOCK_ROOT=/nas/custody-locks
# DO NOT claim destination identity without comparing current kernel mount info.
CUSTODY_DESTINATION_DEVICE=
CUSTODY_DESTINATION_FILESYSTEM_UUID=
CUSTODY_DESTINATION_FILESYSTEM_TYPE=cifs
# Explicitly include historical repositories as READ inputs, not default write roots.
SCAN_ROOTS=/nas/audio,/nas/bodycam,/nas/dashcam,/nas/archive/dashcam,/nas/fileserver/dashcam/sdcard-ingest
TRANSCRIPT_ROOT=/nas/audio/transcriptions
LEGACY_DROP_ROOT=/nas/incoming/deathstar
YOLO_ROOT=/nas/archive/dashcam/yolo
META_ROOT=/nas/archive/dashcam/metadata
# Resolve graph service and credentials separately. Never commit secrets here.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_PASSWORD_DEFAULT=
NEO4J_DB=neo4j
