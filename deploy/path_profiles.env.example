# Copy this file to .env and customize per host.
# Shared fleet namespace. Every host should expose the same logical data plane here.
# Beelink is a documented transition exception until its physical pool mount is moved.
NAS_ROOT=/nas

# Shared queue for distributed workers
DROP_ROOT=/nas/drop

# Preferred roots by data family
AUDIO_ROOT=/nas/audio
DASHCAM_ROOT=/nas/dashcam
BODYCAM_ROOT=/nas/bodycam
TRANSCRIPT_ROOT=/nas/audio/transcriptions
LEGACY_ROOT=/nas

# Scanner roots consumed by run_ingest_all.sh / ingest_transcriptsv5_3.py
SCAN_ROOTS=/nas/audio,/nas/audio/transcriptions,/nas/bodycam,/nas/dashcam,/nas/dashcam/transcriptions

# Neo4j (running on x1-370 Tailscale node)
NEO4J_URI=bolt://100.64.43.123:7687
NEO4J_USER=neo4j
# Per-run override (highest priority); leave blank to use NEO4J_PASSWORD_DEFAULT.
NEO4J_PASSWORD=
# Machine-wide default (single source of truth for the historical password).
NEO4J_PASSWORD_DEFAULT=knowledge_graph_2026
NEO4J_DB=neo4j

# Legacy deathstar drop path visible on x1-370
LEGACY_DROP_ROOT=/nas/incoming/deathstar
YOLO_ROOT=/nas/dashcam/yolo
META_ROOT=/nas/dashcam/metadata

# Canonical shared fleet namespace
CANONICAL_ROOT=/nas
