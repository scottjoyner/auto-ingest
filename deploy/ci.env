# Non-secret CI-only values used to validate docker-compose interpolation.
SCAN_ROOTS=/tmp/auto-ingest/scan
DASHCAM_ROOT=/tmp/auto-ingest/dashcam
AUDIO_ROOT=/tmp/auto-ingest/audio
BODYCAM_ROOT=/tmp/auto-ingest/bodycam
TRANSCRIPT_ROOT=/tmp/auto-ingest/transcripts
YOLO_ROOT=/tmp/auto-ingest/yolo
META_ROOT=/tmp/auto-ingest/meta
DROP_ROOT=/tmp/auto-ingest/drop
LEGACY_DROP_ROOT=/tmp/auto-ingest/legacy
NAS_ROOT=/tmp/auto-ingest/nas
NAS1_ROOT=/tmp/auto-ingest/nas1
NAS2_ROOT=/tmp/auto-ingest/nas2
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ci-only-not-a-secret
NEO4J_DB=neo4j
CONTENT_OS_LLM_BASE_URL=http://127.0.0.1:1234/v1
CONTENT_OS_LLM_API_KEY=ci-only
CONTENT_OS_LLM_MODEL=ci-model
CONTENT_OS_LLM_TEMPERATURE=0
CONTENT_OS_LLM_MAX_TOKENS=64
