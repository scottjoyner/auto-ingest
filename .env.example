# Auto-Ingest Docker Environment Configuration (EXAMPLE)
# Copy to .env and customize per host.
# All paths use mount points shared across the Tailscale network.

# === Host path mounted into containers at /nas ===
NAS_ROOT=/media/scott/NAS4
NAS1_ROOT=/media/scott/SSD_4TB
NAS2_ROOT=/media/scott/NAS4/fileserver

# === Neo4j (running on x1-370 Tailscale node) ===
NEO4J_URI=bolt://100.64.43.123:7687
NEO4J_USER=neo4j
# Per-run / per-shell password (highest priority). Leave unset to use the default below.
NEO4J_PASSWORD=
# Machine-wide default the whole pipeline falls back to when NEO4J_PASSWORD is unset.
# PLACEHOLDER — replace with your real Neo4j password (do NOT commit the real value).
NEO4J_PASSWORD_DEFAULT=CHANGE_ME_neo4j_password
NEO4J_DB=neo4j

# === Shared queue for distributed workers ===
DROP_ROOT=/nas/drop

# === Preferred roots by data family ===
AUDIO_ROOT=/media/scott/SSD_4TB/audio
DASHCAM_ROOT=/media/scott/NAS4/fileserver/dashcam
BODYCAM_ROOT=/media/scott/NAS4/fileserver/bodycam
TRANSCRIPT_ROOT=/media/scott/SSD_4TB/audio/transcriptions
LEGACY_ROOT=/media/scott/NAS4/fileserver

# === Scanner roots consumed by run_ingest_all.sh ===
SCAN_ROOTS=/media/scott/SSD_4TB/audio,/media/scott/NAS4/fileserver/audio,/media/scott/NAS4/fileserver/audio/transcriptions,/media/scott/NAS4/fileserver/bodycam,/media/scott/NAS4/fileserver/dashcam,/media/scott/NAS4/fileserver/dashcam/transcriptions

# === Legacy deathstar drop path visible on x1-370 ===
LEGACY_DROP_ROOT=/media/scott/NAS4/fileserver/incoming/deathstar
YOLO_ROOT=/media/scott/NAS4/fileserver/dashcam/yolo
META_ROOT=/media/scott/NAS4/fileserver/dashcam/metadata

# === Canonical NAS4 root on x1-370 ===
CANONICAL_ROOT=/media/scott/NAS4/fileserver

# === LLM (LM Studio on host) ===
CONTENT_OS_LLM_BASE_URL=http://host.docker.internal:1234/v1
CONTENT_OS_LLM_API_KEY=${CONTENT_OS_LLM_API_KEY}
CONTENT_OS_LLM_MODEL=local-model
CONTENT_OS_LLM_TEMPERATURE=0.4
CONTENT_OS_LLM_MAX_TOKENS=1200

# === SD-card ingest custody (auto_ingest/custody/) ===
# Where the campaign coordination marker lives. This MUST be a path every writer
# can see, not /tmp: sync-service and ingest-cron each have their own /tmp, so a
# marker there is invisible to them and the coordination silently does nothing.
# /nas is bind-mounted into every service that runs the sync.
CUSTODY_LOCK_ROOT=/nas/custody-locks

# Host path of the canonical custody destination. Resolve at runtime rather than
# hardcoding it, so this file stays machine-agnostic; a host with no destination
# configured fails closed at the release gate.
CUSTODY_DESTINATION_ROOT=${CUSTODY_DESTINATION_ROOT}

# Declared identity of the destination storage. The release gate compares this
# declaration against what the kernel reports, and refuses when they differ or
# when there is nothing to compare.
#
# Leave CUSTODY_DESTINATION_FILESYSTEM_UUID set for a block filesystem (that is
# the authoritative identity). For a network share it MUST be empty: CIFS and SMB
# have no block device, so no UUID can ever be observed for them, and declaring
# one is a claim nothing can confirm - which the gate treats as unproven rather
# than as a weaker match. Name the share instead:
#   CUSTODY_DESTINATION_DEVICE=//192.168.1.202/fileserver
CUSTODY_DESTINATION_FILESYSTEM_UUID=
CUSTODY_DESTINATION_DEVICE=
CUSTODY_DESTINATION_FILESYSTEM_TYPE=

# How long a campaign marker stays authoritative before writers conclude no
# campaign is live and proceed. A crashed executor leaves the marker behind, so
# without an expiry one bad kill halts legacy ingest silently and permanently.
# Default 6h (21600s) - deliberately generous, because a ~90GB card copy takes
# hours; the executor refreshes the marker's mtime while it works, so a running
# campaign never looks stale.
CUSTODY_MARKER_TTL_SEC=21600
