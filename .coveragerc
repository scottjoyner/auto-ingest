[run]
branch = True
relative_files = True
source =
    auto_ingest
    content_os
    birdcam
    auto_ingest_config

[report]
show_missing = True
skip_covered = False
precision = 2
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError

[json]
pretty_print = True
